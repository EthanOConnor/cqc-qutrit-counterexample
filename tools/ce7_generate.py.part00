def file_sha256(path: Path, block_size: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        while True:
            block = f.read(block_size)
            if not block:
                break
            h.update(block)
    return h.hexdigest()

# --------------------------- raster handling ---------------------------
@dataclass
class RasterGrid:
    name: str
    path: Path
    data: np.ndarray
    transform: rasterio.Affine
    nodata: float | None

    @classmethod
    def open(cls, name: str, path: Path) -> "RasterGrid":
        with rasterio.open(path) as ds:
            arr = ds.read(1).astype(np.float32)
            nodata = ds.nodata
            transform = ds.transform
            scales = ds.scales
            offsets = ds.offsets
        if scales and scales[0] not in (None, 1.0):
            arr = arr * float(scales[0])
        if offsets and offsets[0] not in (None, 0.0):
            arr = arr + float(offsets[0])
        if nodata is not None and np.isfinite(nodata):
            arr[arr == nodata] = np.nan
        arr[~np.isfinite(arr)] = np.nan
        return cls(name=name, path=path, data=arr, transform=transform, nodata=nodata)

    @property
    def pixel_size_m(self) -> float:
        return abs(float(self.transform.a))

    @property
    def bounds(self) -> tuple[float, float, float, float]:
        h, w = self.data.shape
        x0 = self.transform.c
        y0 = self.transform.f
        x1 = x0 + self.transform.a * w
        y1 = y0 + self.transform.e * h
        return min(x0, x1), min(y0, y1), max(x0, x1), max(y0, y1)

    def sample_bilinear(self, x: np.ndarray, y: np.ndarray) -> np.ndarray:
        # GDAL affine coordinates refer to pixel corners; ndimage indexes pixel centers.
        col = (x - self.transform.c) / self.transform.a - 0.5
        row = (y - self.transform.f) / self.transform.e - 0.5
        vals = map_coordinates(
            self.data,
            [row, col],
            order=1,
            mode="constant",